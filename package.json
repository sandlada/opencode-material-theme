{
  "name": "@sandlada/opencode-material-theme",
  "version": "0.0.3",
  "description": "Material Design 3 (Material You) themes for the OpenCode TUI: 194 static JSON themes across 9 variants x 12 hues, plain + OLED.",
  "scripts": {
    "dev:app": "npm --prefix dev-app run dev",
    "build:app": "npm --prefix dev-app run build",
    "check:dynamic": "bun scripts/check-dynamic.mjs",
    "generate:dynamic": "bun scripts/generate-dynamic-theme.mjs",
    "generate:matrix": "bun scripts/generate-dynamic-matrix.mjs --out ./src/themes",
    "sync:test-theme": "bun scripts/watch-test-theme.mjs --once",
    "watch:test-theme": "bun scripts/watch-test-theme.mjs"
  },
  "keywords": [
    "opencode",
    "tui",
    "theme",
    "themes",
    "material-design-3",
    "material-you",
    "md3",
    "material-color-utilities",
    "oled"
  ],
  "author": "Kai Orion & Sandlada",
  "license": "MIT",
  "type": "module",
  "files": [
    "deprecated-theme/",
    "src/themes/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "opencode-md3-themes": "./bin/install.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@sandlada/mcu-helper": "^0.1.0-20260830.a"
  }
}
