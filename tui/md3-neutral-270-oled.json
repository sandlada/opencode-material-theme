{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#5a5e6c",
    "md3SecondaryLight": "#5e5f65",
    "md3TertiaryLight": "#615b77",
    "md3ErrorLight": "#9f403d",
    "md3OnSurfaceLight": "#323235",
    "md3OnSurfaceVariantLight": "#5f5f61",
    "md3SurfaceLight": "#fcf8f9",
    "md3SurfaceContainerLight": "#f0edef",
    "md3SurfaceContainerHighLight": "#eae7ea",
    "md3OutlineVariantLight": "#b3b1b4",
    "md3OutlineLight": "#7b7a7d",
    "md3SurfaceContainerHighestLight": "#e4e2e5",
    "md3OnSecondaryContainerLight": "#505157",
    "md3OnErrorContainerLight": "#752121",
    "md3PrimaryDark": "#c3c6d6",
    "md3SecondaryDark": "#9d9da4",
    "md3TertiaryDark": "#f1ebff",
    "md3ErrorDark": "#ee7d77",
    "md3OnSurfaceDark": "#e7e5e8",
    "md3OnSurfaceVariantDark": "#acaaad",
    "md3SurfaceDark": "#000000",
    "md3SurfaceContainerDark": "#19191b",
    "md3SurfaceContainerHighDark": "#1f1f21",
    "md3OutlineVariantDark": "#48484a",
