{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#af2910",
    "md3SecondaryLight": "#974636",
    "md3TertiaryLight": "#7c5800",
    "md3ErrorLight": "#ba1a1a",
    "md3OnSurfaceLight": "#261815",
    "md3OnSurfaceVariantLight": "#5a413c",
    "md3SurfaceLight": "#fff8f6",
    "md3SurfaceContainerLight": "#ffe9e5",
    "md3SurfaceContainerHighLight": "#fde2dd",
    "md3OutlineVariantLight": "#e2bfb7",
    "md3OutlineLight": "#8e706a",
    "md3SurfaceContainerHighestLight": "#f8ddd7",
    "md3OnSecondaryContainerLight": "#772e20",
    "md3OnErrorContainerLight": "#93000a",
    "md3PrimaryDark": "#ffb4a5",
    "md3SecondaryDark": "#ffb4a5",
    "md3TertiaryDark": "#f4be54",
    "md3ErrorDark": "#ffb4ab",
    "md3OnSurfaceDark": "#f8ddd7",
    "md3OnSurfaceVariantDark": "#e2bfb7",
    "md3SurfaceDark": "#000000",
    "md3SurfaceContainerDark": "#2b1c19",
    "md3SurfaceContainerHighDark": "#362623",
    "md3OutlineVariantDark": "#5a413c",
    "md3OutlineDark": "#a98983",
