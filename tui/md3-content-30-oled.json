      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "markdownHeading": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "markdownLink": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownLinkText": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "markdownCode": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "markdownBlockQuote": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "markdownEmph": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownStrong": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "markdownHorizontalRule": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "markdownListItem": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "markdownListEnumeration": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownImage": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownImageText": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "markdownCodeBlock": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "syntaxComment": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "syntaxKeyword": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "syntaxFunction": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "syntaxVariable": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "syntaxString": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "syntaxNumber": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "syntaxType": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "syntaxOperator": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "syntaxPunctuation": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    }
  }
