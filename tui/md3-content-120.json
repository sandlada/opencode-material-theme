{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#546200",
    "md3SecondaryLight": "#5a6233",
    "md3TertiaryLight": "#006b2a",
    "md3ErrorLight": "#ba1a1a",
    "md3OnSurfaceLight": "#1b1c14",
    "md3OnSurfaceVariantLight": "#464838",
    "md3SurfaceLight": "#fbfaec",
    "md3SurfaceContainerLight": "#efeee0",
    "md3SurfaceContainerHighLight": "#eae9db",
    "md3OutlineVariantLight": "#c7c8b2",
    "md3OutlineLight": "#777966",
    "md3SurfaceContainerHighestLight": "#e4e3d5",
    "md3OnSecondaryContainerLight": "#606939",
    "md3OnErrorContainerLight": "#93000a",
    "md3PrimaryDark": "#bbd156",
    "md3SecondaryDark": "#c3cc92",
    "md3TertiaryDark": "#7eda8a",
    "md3ErrorDark": "#ffb4ab",
