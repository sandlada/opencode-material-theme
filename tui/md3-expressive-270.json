{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#3a5ca9",
    "md3SecondaryLight": "#3d6759",
    "md3TertiaryLight": "#006d4f",
    "md3ErrorLight": "#ac3434",
    "md3OnSurfaceLight": "#223156",
    "md3OnSurfaceVariantLight": "#4f5e86",
    "md3SurfaceLight": "#faf8ff",
    "md3SurfaceContainerLight": "#eaedff",
    "md3SurfaceContainerHighLight": "#e2e7ff",
    "md3OutlineVariantLight": "#a2b1de",
    "md3OutlineLight": "#6b7aa3",
    "md3SurfaceContainerHighestLight": "#dae2ff",
    "md3OnSecondaryContainerLight": "#386254",
    "md3OnErrorContainerLight": "#65000b",
    "md3PrimaryDark": "#b5c8ff",
    "md3SecondaryDark": "#b2ccc1",
    "md3TertiaryDark": "#daffec",
    "md3ErrorDark": "#ff716c",
    "md3OnSurfaceDark": "#dee5ff",
    "md3OnSurfaceVariantDark": "#a0aacb",
    "md3SurfaceDark": "#090e1b",
    "md3SurfaceContainerDark": "#11192c",
    "md3SurfaceContainerHighDark": "#161f36",
    "md3OutlineVariantDark": "#3d4763",
    "md3OutlineDark": "#6b7593",
    "md3SurfaceContainerHighestDark": "#1b253f",
    "md3OnSecondaryContainerDark": "#90aa9f",
    "md3OnErrorContainerDark": "#ff9993"
