{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#4c57a9",
    "md3SecondaryLight": "#535a92",
    "md3TertiaryLight": "#7d4e7d",
    "md3ErrorLight": "#ba1a1a",
    "md3OnSurfaceLight": "#221921",
    "md3OnSurfaceVariantLight": "#534152",
    "md3SurfaceLight": "#fff7fa",
    "md3SurfaceContainerLight": "#fbe9f5",
    "md3SurfaceContainerHighLight": "#f5e3f0",
    "md3OutlineVariantLight": "#d8bfd4",
    "md3OutlineLight": "#867183",
    "md3SurfaceContainerHighestLight": "#efdeea",
    "md3OnSecondaryContainerLight": "#3b4279",
    "md3OnErrorContainerLight": "#93000a",
    "md3PrimaryDark": "#bcc3ff",
    "md3SecondaryDark": "#bcc3ff",
    "md3TertiaryDark": "#edb4eb",
    "md3ErrorDark": "#ffb4ab",
    "md3OnSurfaceDark": "#efdeea",
    "md3OnSurfaceVariantDark": "#d8bfd4",
    "md3SurfaceDark": "#191019",
    "md3SurfaceContainerDark": "#261d25",
    "md3SurfaceContainerHighDark": "#312730",
    "md3OutlineVariantDark": "#534152",
    "md3OutlineDark": "#a18a9d",
