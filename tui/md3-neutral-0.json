{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#6a5b5e",
    "md3SecondaryLight": "#655d5e",
    "md3TertiaryLight": "#6f576f",
    "md3ErrorLight": "#9e3f4e",
    "md3OnSurfaceLight": "#363132",
    "md3OnSurfaceVariantLight": "#645d5e",
    "md3SurfaceLight": "#fff8f8",
    "md3SurfaceContainerLight": "#f4ecec",
    "md3SurfaceContainerHighLight": "#efe6e7",
    "md3OutlineVariantLight": "#b9b0b1",
    "md3OutlineLight": "#80797a",
    "md3SurfaceContainerHighestLight": "#eae0e1",
    "md3OnSecondaryContainerLight": "#575051",
    "md3OnErrorContainerLight": "#782232",
    "md3PrimaryDark": "#d5c2c6",
    "md3SecondaryDark": "#a59b9d",
    "md3TertiaryDark": "#ffebfb",
    "md3ErrorDark": "#ec7c8a",
    "md3OnSurfaceDark": "#ede3e4",
