{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#4d5e8b",
    "md3SecondaryLight": "#585f72",
    "md3TertiaryLight": "#6b5780",
    "md3ErrorLight": "#a83836",
    "md3OnSurfaceLight": "#30323a",
    "md3OnSurfaceVariantLight": "#5d5f68",
    "md3SurfaceLight": "#faf8fe",
    "md3SurfaceContainerLight": "#ededf6",
    "md3SurfaceContainerHighLight": "#e7e7f1",
    "md3OutlineVariantLight": "#b0b1bc",
    "md3OutlineLight": "#787a84",
    "md3SurfaceContainerHighestLight": "#e1e2ed",
    "md3OnSecondaryContainerLight": "#4b5164",
    "md3OnErrorContainerLight": "#6e0a12",
    "md3PrimaryDark": "#b9c6ee",
    "md3SecondaryDark": "#c0c6dd",
    "md3TertiaryDark": "#eed7ff",
    "md3ErrorDark": "#fa746f",
    "md3OnSurfaceDark": "#e4e5f0",
    "md3OnSurfaceVariantDark": "#a9aab5",
    "md3SurfaceDark": "#000000",
    "md3SurfaceContainerDark": "#18191f",
    "md3SurfaceContainerHighDark": "#1d1f26",
    "md3OutlineVariantDark": "#454850",
    "md3OutlineDark": "#73757f",
    "md3SurfaceContainerHighestDark": "#23262e",
    "md3OnSecondaryContainerDark": "#b9bfd5",
    "md3OnErrorContainerDark": "#ff9993"
