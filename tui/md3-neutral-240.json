  "defs": {
    "md3PrimaryLight": "#595f65",
    "md3SecondaryLight": "#5d5f62",
    "md3TertiaryLight": "#535f78",
    "md3ErrorLight": "#9f403d",
    "md3OnSurfaceLight": "#313234",
    "md3OnSurfaceVariantLight": "#5e5f61",
    "md3SurfaceLight": "#fbf9f9",
    "md3SurfaceContainerLight": "#efedee",
    "md3SurfaceContainerHighLight": "#e9e8e9",
    "md3OutlineVariantLight": "#b2b2b4",
    "md3OutlineLight": "#7a7b7c",
