  "defs": {
    "md3PrimaryLight": "#5f692e",
    "md3SecondaryLight": "#63674b",
    "md3TertiaryLight": "#78622a",
    "md3ErrorLight": "#ae4025",
    "md3OnSurfaceLight": "#37392c",
    "md3OnSurfaceVariantLight": "#646557",
    "md3SurfaceLight": "#fefcf2",
    "md3SurfaceContainerLight": "#f5f4e5",
    "md3SurfaceContainerHighLight": "#efefdf",
    "md3OutlineVariantLight": "#babaa9",
    "md3OutlineLight": "#818272",
    "md3SurfaceContainerHighestLight": "#e9e9d7",
