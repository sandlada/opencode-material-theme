{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#006c5c",
    "md3SecondaryLight": "#745b2f",
    "md3TertiaryLight": "#825600",
    "md3ErrorLight": "#ac3434",
    "md3OnSurfaceLight": "#003936",
    "md3OnSurfaceVariantLight": "#2b6964",
    "md3SurfaceLight": "#e4fffb",
    "md3SurfaceContainerLight": "#c8f7f2",
    "md3SurfaceContainerHighLight": "#bcf3ed",
    "md3OutlineVariantLight": "#80bdb7",
    "md3OutlineLight": "#498580",
    "md3SurfaceContainerHighestLight": "#b0eee8",
    "md3OnSecondaryContainerLight": "#664e23",
    "md3OnErrorContainerLight": "#65000b",
    "md3PrimaryDark": "#e5fff7",
    "md3SecondaryDark": "#dbc3a1",
    "md3TertiaryDark": "#ffc87a",
    "md3ErrorDark": "#ff716c",
    "md3OnSurfaceDark": "#c2eee9",
    "md3OnSurfaceVariantDark": "#89b3af",
    "md3SurfaceDark": "#000000",
    "md3SurfaceContainerDark": "#001e1c",
    "md3SurfaceContainerHighDark": "#002422",
    "md3OutlineVariantDark": "#254f4b",
    "md3OutlineDark": "#547d79",
    "md3SurfaceContainerHighestDark": "#002b29",
    "md3OnSecondaryContainerDark": "#b6a180",
    "md3OnErrorContainerDark": "#ff9993"
  },
  "theme": {
    "primary": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "secondary": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "accent": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "error": {
      "dark": "md3ErrorDark",
      "light": "md3ErrorLight"
    },
    "warning": {
      "dark": "md3OnErrorContainerDark",
      "light": "md3OnErrorContainerLight"
    },
    "success": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "info": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "text": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "textMuted": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "background": {
      "dark": "md3SurfaceDark",
      "light": "md3SurfaceLight"
    },
    "backgroundPanel": {
      "dark": "md3SurfaceContainerDark",
      "light": "md3SurfaceContainerLight"
    },
    "backgroundElement": {
      "dark": "md3SurfaceContainerHighDark",
      "light": "md3SurfaceContainerHighLight"
    },
    "border": {
      "dark": "md3OutlineVariantDark",
      "light": "md3OutlineVariantLight"
    },
    "borderActive": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "borderSubtle": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighestLight"
    },
    "diffAdded": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "diffRemoved": {
      "dark": "md3ErrorDark",
      "light": "md3ErrorLight"
    },
    "diffContext": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "diffHunkHeader": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "diffHighlightAdded": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "diffHighlightRemoved": {
      "dark": "md3OnErrorContainerDark",
      "light": "md3OnErrorContainerLight"
    },
    "diffAddedBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighLight"
    },
    "diffRemovedBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighestLight"
    },
    "diffContextBg": {
      "dark": "md3SurfaceContainerDark",
      "light": "md3SurfaceContainerLight"
    },
    "diffLineNumber": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "diffAddedLineNumberBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighLight"
    },
    "diffRemovedLineNumberBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighestLight"
    },
    "markdownText": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "markdownHeading": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "markdownLink": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownLinkText": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "markdownCode": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "markdownBlockQuote": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "markdownEmph": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownStrong": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "markdownHorizontalRule": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "markdownListItem": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "markdownListEnumeration": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownImage": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownImageText": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "markdownCodeBlock": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "syntaxComment": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "syntaxKeyword": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "syntaxFunction": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "syntaxVariable": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "syntaxString": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "syntaxNumber": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "syntaxType": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "syntaxOperator": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "syntaxPunctuation": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    }
  }
}
