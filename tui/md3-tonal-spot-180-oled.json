{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#226a5c",
    "md3SecondaryLight": "#4b645d",
    "md3TertiaryLight": "#316675",
    "md3ErrorLight": "#a83836",
    "md3OnSurfaceLight": "#2a3532",
    "md3OnSurfaceVariantLight": "#57615e",
    "md3SurfaceLight": "#f6faf7",
    "md3SurfaceContainerLight": "#e7f0ec",
    "md3SurfaceContainerHighLight": "#e1eae6",
    "md3OutlineVariantLight": "#a9b4b0",
    "md3OutlineLight": "#727d79",
    "md3SurfaceContainerHighestLight": "#dae5e0",
    "md3OnSecondaryContainerLight": "#3e5750",
    "md3OnErrorContainerLight": "#6e0a12",
    "md3PrimaryDark": "#9dd1c3",
    "md3SecondaryDark": "#b1ccc4",
    "md3TertiaryDark": "#dbf5ff",
    "md3ErrorDark": "#fa746f",
    "md3OnSurfaceDark": "#dde8e3",
    "md3OnSurfaceVariantDark": "#a2aea9",
    "md3SurfaceDark": "#000000",
