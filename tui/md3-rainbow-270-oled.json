{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#395ba9",
    "md3SecondaryLight": "#585e71",
    "md3TertiaryLight": "#735572",
    "md3ErrorLight": "#ba1a1a",
    "md3OnSurfaceLight": "#1b1b1b",
    "md3OnSurfaceVariantLight": "#474747",
    "md3SurfaceLight": "#f9f9f9",
    "md3SurfaceContainerLight": "#eeeeee",
    "md3SurfaceContainerHighLight": "#e8e8e8",
    "md3OutlineVariantLight": "#c6c6c6",
    "md3OutlineLight": "#777777",
    "md3SurfaceContainerHighestLight": "#e2e2e2",
    "md3OnSecondaryContainerLight": "#404659",
    "md3OnErrorContainerLight": "#93000a",
    "md3PrimaryDark": "#b1c5ff",
    "md3SecondaryDark": "#c0c6dd",
    "md3TertiaryDark": "#e0bbdd",
    "md3ErrorDark": "#ffb4ab",
    "md3OnSurfaceDark": "#e2e2e2",
    "md3OnSurfaceVariantDark": "#c6c6c6",
    "md3SurfaceDark": "#000000",
    "md3SurfaceContainerDark": "#1f1f1f",
    "md3SurfaceContainerHighDark": "#2a2a2a",
    "md3OutlineVariantDark": "#474747",
    "md3OutlineDark": "#919191",
    "md3SurfaceContainerHighestDark": "#353535",
    "md3OnSecondaryContainerDark": "#dce2f9",
    "md3OnErrorContainerDark": "#ffdad6"
