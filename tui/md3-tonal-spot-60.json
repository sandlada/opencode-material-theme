{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#855426",
    "md3SecondaryLight": "#745a44",
    "md3TertiaryLight": "#64612a",
    "md3ErrorLight": "#a73b21",
    "md3OnSurfaceLight": "#3c3026",
    "md3OnSurfaceVariantLight": "#6b5c51",
    "md3SurfaceLight": "#fff8f5",
    "md3SurfaceContainerLight": "#fdebdf",
    "md3SurfaceContainerHighLight": "#f8e5d8",
    "md3OutlineVariantLight": "#c1aea1",
    "md3OutlineLight": "#88786c",
    "md3SurfaceContainerHighestLight": "#f3dfd0",
    "md3OnSecondaryContainerLight": "#664d38",
    "md3OnErrorContainerLight": "#6e1400",
    "md3PrimaryDark": "#f2bc8f",
    "md3SecondaryDark": "#e3c0a5",
    "md3TertiaryDark": "#fffada",
    "md3ErrorDark": "#f97758",
