{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#735c1b",
    "md3SecondaryLight": "#6a5e40",
    "md3TertiaryLight": "#82552f",
    "md3ErrorLight": "#a73b21",
    "md3OnSurfaceLight": "#383225",
    "md3OnSurfaceVariantLight": "#665e4f",
    "md3SurfaceLight": "#fff8f1",
    "md3SurfaceContainerLight": "#f6eddd",
    "md3SurfaceContainerHighLight": "#f1e7d6",
    "md3OutlineVariantLight": "#bab19f",
    "md3OutlineLight": "#827a6a",
    "md3SurfaceContainerHighestLight": "#ece1ce",
    "md3OnSecondaryContainerLight": "#5c5134",
    "md3OnErrorContainerLight": "#6e1400",
    "md3PrimaryDark": "#ddc487",
    "md3SecondaryDark": "#d5c5a0",
    "md3TertiaryDark": "#ffcea8",
    "md3ErrorDark": "#f97758",
    "md3OnSurfaceDark": "#efe4d1",
