{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#9d4332",
    "md3SecondaryLight": "#3f6475",
    "md3TertiaryLight": "#006882",
    "md3ErrorLight": "#ac3149",
    "md3OnSurfaceLight": "#522613",
    "md3OnSurfaceVariantLight": "#87513b",
    "md3SurfaceLight": "#fff8f6",
    "md3SurfaceContainerLight": "#ffe9e2",
    "md3SurfaceContainerHighLight": "#ffe2d8",
    "md3OutlineVariantLight": "#e6a288",
    "md3OutlineLight": "#a76c55",
    "md3SurfaceContainerHighestLight": "#ffdbce",
    "md3OnSecondaryContainerLight": "#325667",
    "md3OnErrorContainerLight": "#68001f",
    "md3PrimaryDark": "#ffb4a5",
    "md3SecondaryDark": "#b4cad6",
    "md3TertiaryDark": "#86ddff",
    "md3ErrorDark": "#fd6f85",
    "md3OnSurfaceDark": "#ffdfd3",
    "md3OnSurfaceVariantDark": "#d49f8b",
    "md3SurfaceDark": "#000000",
    "md3SurfaceContainerDark": "#2b1309",
    "md3SurfaceContainerHighDark": "#34180c",
    "md3OutlineVariantDark": "#653e2e",
    "md3OutlineDark": "#996a58",
    "md3SurfaceContainerHighestDark": "#3d1d0f",
