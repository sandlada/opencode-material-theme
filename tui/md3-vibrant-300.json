{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#6b34d8",
    "md3SecondaryLight": "#7543a8",
    "md3TertiaryLight": "#9d365b",
    "md3ErrorLight": "#b41340",
    "md3OnSurfaceLight": "#39264c",
    "md3OnSurfaceVariantLight": "#68537c",
    "md3SurfaceLight": "#fdf3ff",
    "md3SurfaceContainerLight": "#f4e2ff",
    "md3SurfaceContainerHighLight": "#f0dbff",
    "md3OutlineVariantLight": "#bca4d2",
    "md3OutlineLight": "#846e99",
    "md3SurfaceContainerHighestLight": "#ecd4ff",
    "md3OnSecondaryContainerLight": "#5f2c92",
    "md3OnErrorContainerLight": "#510017",
    "md3PrimaryDark": "#ba9eff",
    "md3SecondaryDark": "#c38ef9",
    "md3TertiaryDark": "#ff97b5",
    "md3ErrorDark": "#ff6e84",
    "md3OnSurfaceDark": "#f2dfff",
    "md3OnSurfaceVariantDark": "#baa2cf",
    "md3SurfaceDark": "#170529",
    "md3SurfaceContainerDark": "#240e3b",
    "md3SurfaceContainerHighDark": "#2b1344",
    "md3OutlineVariantDark": "#534067",
