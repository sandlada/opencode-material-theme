{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#865300",
    "md3SecondaryLight": "#825513",
    "md3TertiaryLight": "#586420",
    "md3ErrorLight": "#ba1a1a",
    "md3OnSurfaceLight": "#1b1d10",
    "md3OnSurfaceVariantLight": "#45492f",
    "md3SurfaceLight": "#fafbe5",
    "md3SurfaceContainerLight": "#efefda",
    "md3SurfaceContainerHighLight": "#e9ead4",
    "md3OutlineVariantLight": "#c5c9a8",
    "md3OutlineLight": "#757a5c",
    "md3SurfaceContainerHighestLight": "#e3e4cf",
    "md3OnSecondaryContainerLight": "#653e00",
    "md3OnErrorContainerLight": "#93000a",
    "md3PrimaryDark": "#ffb960",
    "md3SecondaryDark": "#f8bb71",
    "md3TertiaryDark": "#c0ce7e",
    "md3ErrorDark": "#ffb4ab",
    "md3OnSurfaceDark": "#e3e4cf",
    "md3OnSurfaceVariantDark": "#c5c9a8",
    "md3SurfaceDark": "#121408",
    "md3SurfaceContainerDark": "#1f2113",
    "md3SurfaceContainerHighDark": "#292b1d",
    "md3OutlineVariantDark": "#45492f",
    "md3OutlineDark": "#8f9375",
