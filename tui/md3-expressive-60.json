{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#8f4f00",
    "md3SecondaryLight": "#4e607d",
    "md3TertiaryLight": "#0e61a5",
    "md3ErrorLight": "#aa371c",
    "md3OnSurfaceLight": "#4a2c00",
    "md3OnSurfaceVariantLight": "#7d5827",
    "md3SurfaceLight": "#fff8f4",
    "md3SurfaceContainerLight": "#ffead7",
    "md3SurfaceContainerHighLight": "#ffe4c8",
    "md3OutlineVariantLight": "#d9a971",
    "md3OutlineLight": "#9c733f",
    "md3SurfaceContainerHighestLight": "#ffddb8",
    "md3OnSecondaryContainerLight": "#40526f",
    "md3OnErrorContainerLight": "#671200",
    "md3PrimaryDark": "#ffbf89",
    "md3SecondaryDark": "#bdc7dc",
    "md3TertiaryDark": "#a0c9ff",
    "md3ErrorDark": "#fe7453",
    "md3OnSurfaceDark": "#ffe0c0",
    "md3OnSurfaceVariantDark": "#caa47a",
    "md3SurfaceDark": "#180c01",
    "md3SurfaceContainerDark": "#271602",
    "md3SurfaceContainerHighDark": "#2f1b02",
    "md3OutlineVariantDark": "#5e4320",
    "md3OutlineDark": "#906f49",
