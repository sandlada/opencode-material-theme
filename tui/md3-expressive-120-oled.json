{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#364000",
    "md3SecondaryLight": "#5b6384",
    "md3TertiaryLight": "#525db0",
    "md3ErrorLight": "#b23d21",
    "md3OnSurfaceLight": "#323c00",
    "md3OnSurfaceVariantLight": "#5d6a18",
    "md3SurfaceLight": "#fcffde",
    "md3SurfaceContainerLight": "#effab7",
    "md3SurfaceContainerHighLight": "#e8f5a3",
    "md3OutlineVariantLight": "#b1c166",
    "md3OutlineLight": "#798733",
    "md3SurfaceContainerHighestLight": "#e0f190",
    "md3OnSecondaryContainerLight": "#495070",
    "md3OnErrorContainerLight": "#671200",
    "md3PrimaryDark": "#f6ffc1",
    "md3SecondaryDark": "#c2c5dd",
    "md3TertiaryDark": "#bcc2ff",
    "md3ErrorDark": "#fe7453",
    "md3OnSurfaceDark": "#e4e9c1",
    "md3OnSurfaceVariantDark": "#a9ae8a",
    "md3SurfaceDark": "#000000",
    "md3SurfaceContainerDark": "#191b0e",
    "md3SurfaceContainerHighDark": "#1e2111",
    "md3OutlineVariantDark": "#464b2d",
    "md3OutlineDark": "#737857",
    "md3SurfaceContainerHighestDark": "#242714",
    "md3OnSecondaryContainerDark": "#9fa3b9",
    "md3OnErrorContainerDark": "#ff9b82"
  },
  "theme": {
    "primary": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "secondary": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "accent": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "error": {
      "dark": "md3ErrorDark",
      "light": "md3ErrorLight"
    },
    "warning": {
      "dark": "md3OnErrorContainerDark",
      "light": "md3OnErrorContainerLight"
    },
    "success": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "info": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "text": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "textMuted": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "background": {
      "dark": "md3SurfaceDark",
      "light": "md3SurfaceLight"
    },
    "backgroundPanel": {
      "dark": "md3SurfaceContainerDark",
      "light": "md3SurfaceContainerLight"
    },
    "backgroundElement": {
      "dark": "md3SurfaceContainerHighDark",
      "light": "md3SurfaceContainerHighLight"
    },
    "border": {
      "dark": "md3OutlineVariantDark",
      "light": "md3OutlineVariantLight"
    },
    "borderActive": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "borderSubtle": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighestLight"
    },
    "diffAdded": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "diffRemoved": {
      "dark": "md3ErrorDark",
      "light": "md3ErrorLight"
    },
    "diffContext": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "diffHunkHeader": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "diffHighlightAdded": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "diffHighlightRemoved": {
      "dark": "md3OnErrorContainerDark",
      "light": "md3OnErrorContainerLight"
    },
    "diffAddedBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighLight"
    },
    "diffRemovedBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighestLight"
    },
    "diffContextBg": {
      "dark": "md3SurfaceContainerDark",
      "light": "md3SurfaceContainerLight"
    },
    "diffLineNumber": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "diffAddedLineNumberBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighLight"
    },
    "diffRemovedLineNumberBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighestLight"
    },
    "markdownText": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "markdownHeading": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "markdownLink": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownLinkText": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "markdownCode": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "markdownBlockQuote": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "markdownEmph": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownStrong": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "markdownHorizontalRule": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "markdownListItem": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "markdownListEnumeration": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownImage": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownImageText": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "markdownCodeBlock": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "syntaxComment": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "syntaxKeyword": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "syntaxFunction": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "syntaxVariable": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "syntaxString": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "syntaxNumber": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "syntaxType": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "syntaxOperator": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "syntaxPunctuation": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    }
  }
}
