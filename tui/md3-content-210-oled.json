{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#006874",
    "md3SecondaryLight": "#42646a",
    "md3TertiaryLight": "#744e8c",
    "md3ErrorLight": "#ba1a1a",
    "md3OnSurfaceLight": "#181c1d",
    "md3OnSurfaceVariantLight": "#3e494b",
    "md3SurfaceLight": "#f6fafb",
    "md3SurfaceContainerLight": "#ebeeef",
    "md3SurfaceContainerHighLight": "#e5e9ea",
    "md3OutlineVariantLight": "#bdc9cb",
    "md3OutlineLight": "#6e797b",
    "md3SurfaceContainerHighestLight": "#dfe3e4",
    "md3OnSecondaryContainerLight": "#486a70",
    "md3OnErrorContainerLight": "#93000a",
    "md3PrimaryDark": "#75d4e5",
    "md3SecondaryDark": "#aacdd3",
    "md3TertiaryDark": "#e2b6fc",
    "md3ErrorDark": "#ffb4ab",
    "md3OnSurfaceDark": "#dfe3e4",
    "md3OnSurfaceVariantDark": "#bdc9cb",
    "md3SurfaceDark": "#000000",
    "md3SurfaceContainerDark": "#1c2021",
