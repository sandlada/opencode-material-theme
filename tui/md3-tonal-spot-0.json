    "md3TertiaryLight": "#71557b",
    "md3ErrorLight": "#a8364b",
    "md3OnSurfaceLight": "#3c2f32",
    "md3OnSurfaceVariantLight": "#6b5b5f",
    "md3SurfaceLight": "#fff8f8",
    "md3SurfaceContainerLight": "#fce9ed",
    "md3SurfaceContainerHighLight": "#f7e3e7",
