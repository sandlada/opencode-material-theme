{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#5e5f52",
    "md3SecondaryLight": "#65655e",
    "md3TertiaryLight": "#5c6948",
    "md3ErrorLight": "#a54731",
    "md3OnSurfaceLight": "#383834",
    "md3OnSurfaceVariantLight": "#65645f",
    "md3SurfaceLight": "#fcffde",
    "md3SurfaceContainerLight": "#f6f3ee",
    "md3SurfaceContainerHighLight": "#f0ede8",
    "md3OutlineVariantLight": "#bbb9b3",
    "md3OutlineLight": "#82817b",
    "md3SurfaceContainerHighestLight": "#ebe8e1",
    "md3OnSecondaryContainerLight": "#52524c",
    "md3OnErrorContainerLight": "#742410",
    "md3PrimaryDark": "#c7c7b7",
    "md3SecondaryDark": "#9f9e97",
