  "defs": {
    "md3PrimaryLight": "#6a5c51",
    "md3SecondaryLight": "#655e58",
    "md3TertiaryLight": "#6f5d37",
    "md3ErrorLight": "#9e422c",
    "md3OnSurfaceLight": "#36312e",
    "md3OnSurfaceVariantLight": "#645e5a",
    "md3SurfaceLight": "#fff8f5",
    "md3SurfaceContainerLight": "#f4ece8",
    "md3SurfaceContainerHighLight": "#efe6e2",
    "md3OutlineVariantLight": "#b9b0ab",
    "md3OutlineLight": "#807975",
    "md3SurfaceContainerHighestLight": "#eae1db",
    "md3OnSecondaryContainerLight": "#58504b",
    "md3OnErrorContainerLight": "#742410",
    "md3PrimaryDark": "#d6c3b6",
    "md3SecondaryDark": "#a69c96",
