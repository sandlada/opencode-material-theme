{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#8a4c00",
    "md3SecondaryLight": "#825100",
    "md3TertiaryLight": "#6e5a00",
    "md3ErrorLight": "#b02500",
    "md3OnSurfaceLight": "#442800",
    "md3OnSurfaceVariantLight": "#795425",
    "md3SurfaceLight": "#fff5ed",
    "md3SurfaceContainerLight": "#ffe4c8",
    "md3SurfaceContainerHighLight": "#ffddb8",
    "md3OutlineVariantLight": "#d3a56e",
    "md3OutlineLight": "#976f3e",
    "md3SurfaceContainerHighestLight": "#ffd6a8",
    "md3OnSecondaryContainerLight": "#663f00",
    "md3OnErrorContainerLight": "#520c00",
    "md3PrimaryDark": "#ffa44d",
    "md3SecondaryDark": "#fda626",
    "md3TertiaryDark": "#ffe79a",
    "md3ErrorDark": "#ff7351",
    "md3OnSurfaceDark": "#ffe0c0",
    "md3OnSurfaceVariantDark": "#d1a36c",
    "md3SurfaceDark": "#000000",
    "md3SurfaceContainerDark": "#281500",
    "md3SurfaceContainerHighDark": "#301b00",
    "md3OutlineVariantDark": "#624114",
    "md3OutlineDark": "#966e3c",
    "md3SurfaceContainerHighestDark": "#382000",
    "md3OnSecondaryContainerDark": "#fff6f0",
    "md3OnErrorContainerDark": "#ffd2c8"
  },
  "theme": {
    "primary": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "secondary": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "accent": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "error": {
      "dark": "md3ErrorDark",
      "light": "md3ErrorLight"
    },
    "warning": {
      "dark": "md3OnErrorContainerDark",
      "light": "md3OnErrorContainerLight"
    },
    "success": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "info": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "text": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "textMuted": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "background": {
      "dark": "md3SurfaceDark",
      "light": "md3SurfaceLight"
    },
    "backgroundPanel": {
      "dark": "md3SurfaceContainerDark",
      "light": "md3SurfaceContainerLight"
    },
    "backgroundElement": {
      "dark": "md3SurfaceContainerHighDark",
      "light": "md3SurfaceContainerHighLight"
    },
    "border": {
      "dark": "md3OutlineVariantDark",
      "light": "md3OutlineVariantLight"
    },
    "borderActive": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "borderSubtle": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighestLight"
    },
    "diffAdded": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "diffRemoved": {
      "dark": "md3ErrorDark",
      "light": "md3ErrorLight"
    },
    "diffContext": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "diffHunkHeader": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "diffHighlightAdded": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "diffHighlightRemoved": {
      "dark": "md3OnErrorContainerDark",
      "light": "md3OnErrorContainerLight"
    },
    "diffAddedBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighLight"
    },
    "diffRemovedBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighestLight"
    },
    "diffContextBg": {
      "dark": "md3SurfaceContainerDark",
      "light": "md3SurfaceContainerLight"
    },
    "diffLineNumber": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "diffAddedLineNumberBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighLight"
    },
    "diffRemovedLineNumberBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighestLight"
    },
    "markdownText": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "markdownHeading": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "markdownLink": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownLinkText": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "markdownCode": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "markdownBlockQuote": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "markdownEmph": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownStrong": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "markdownHorizontalRule": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "markdownListItem": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "markdownListEnumeration": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownImage": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "markdownImageText": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "markdownCodeBlock": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "syntaxComment": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
    },
    "syntaxKeyword": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "syntaxFunction": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "syntaxVariable": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "syntaxString": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "syntaxNumber": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "syntaxType": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "syntaxOperator": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "syntaxPunctuation": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    }
  }
}
