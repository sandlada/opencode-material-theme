    "md3ErrorLight": "#9e3f4e",
    "md3OnSurfaceLight": "#353134",
    "md3OnSurfaceVariantLight": "#625e60",
    "md3SurfaceLight": "#fef8f9",
    "md3SurfaceContainerLight": "#f3ecee",
