{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#9d23aa",
    "md3SecondaryLight": "#824984",
    "md3TertiaryLight": "#5e6200",
    "md3ErrorLight": "#ba1a1a",
    "md3OnSurfaceLight": "#211921",
    "md3OnSurfaceVariantLight": "#514250",
    "md3SurfaceLight": "#fff7fa",
    "md3SurfaceContainerLight": "#fae9f5",
    "md3SurfaceContainerHighLight": "#f4e4ef",
    "md3OutlineVariantLight": "#d6c0d1",
    "md3OutlineLight": "#847281",
    "md3SurfaceContainerHighestLight": "#eedee9",
    "md3OnSecondaryContainerLight": "#7b437e",
    "md3OnErrorContainerLight": "#93000a",
    "md3PrimaryDark": "#ffa9ff",
    "md3SecondaryDark": "#f4b0f3",
    "md3TertiaryDark": "#c8cd56",
    "md3ErrorDark": "#ffb4ab",
    "md3OnSurfaceDark": "#eedee9",
    "md3OnSurfaceVariantDark": "#d6c0d1",
    "md3SurfaceDark": "#191118",
    "md3SurfaceContainerDark": "#261d25",
    "md3SurfaceContainerHighDark": "#30272f",
