{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#006a64",
    "md3SecondaryLight": "#006a64",
    "md3TertiaryLight": "#246488",
    "md3ErrorLight": "#ba1a1a",
    "md3OnSurfaceLight": "#141d23",
    "md3OnSurfaceVariantLight": "#384956",
    "md3SurfaceLight": "#f6faff",
    "md3SurfaceContainerLight": "#e6eff8",
    "md3SurfaceContainerHighLight": "#e0e9f2",
    "md3OutlineVariantLight": "#b7c9d8",
    "md3OutlineLight": "#687987",
    "md3SurfaceContainerHighestLight": "#dbe4ed",
    "md3OnSecondaryContainerLight": "#00504b",
    "md3OnErrorContainerLight": "#93000a",
    "md3PrimaryDark": "#50dbd0",
    "md3SecondaryDark": "#81d5cd",
    "md3TertiaryDark": "#94cdf6",
    "md3ErrorDark": "#ffb4ab",
    "md3OnSurfaceDark": "#dbe4ed",
    "md3OnSurfaceVariantDark": "#b7c9d8",
    "md3SurfaceDark": "#000000",
    "md3SurfaceContainerDark": "#182127",
    "md3SurfaceContainerHighDark": "#222b32",
    "md3OutlineVariantDark": "#384956",
    "md3OutlineDark": "#8193a2",
    "md3SurfaceContainerHighestDark": "#2d363d",
    "md3OnSecondaryContainerDark": "#9df2e9",
    "md3OnErrorContainerDark": "#ffdad6"
  },
  "theme": {
    "primary": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "secondary": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "accent": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "error": {
      "dark": "md3ErrorDark",
      "light": "md3ErrorLight"
    },
    "warning": {
      "dark": "md3OnErrorContainerDark",
      "light": "md3OnErrorContainerLight"
    },
    "success": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "info": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "text": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "textMuted": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "background": {
      "dark": "md3SurfaceDark",
      "light": "md3SurfaceLight"
    },
    "backgroundPanel": {
      "dark": "md3SurfaceContainerDark",
      "light": "md3SurfaceContainerLight"
    },
    "backgroundElement": {
      "dark": "md3SurfaceContainerHighDark",
      "light": "md3SurfaceContainerHighLight"
    },
    "border": {
      "dark": "md3OutlineVariantDark",
      "light": "md3OutlineVariantLight"
