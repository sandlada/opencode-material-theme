    "diffAddedLineNumberBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighLight"
    },
    "diffRemovedLineNumberBg": {
      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighestLight"
    },
