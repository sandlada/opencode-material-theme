{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#006d43",
    "md3SecondaryLight": "#286a48",
    "md3TertiaryLight": "#006875",
    "md3ErrorLight": "#ba1a1a",
    "md3OnSurfaceLight": "#111d20",
    "md3OnSurfaceVariantLight": "#334b4f",
    "md3SurfaceLight": "#eefcff",
    "md3SurfaceContainerLight": "#e3f0f3",
    "md3SurfaceContainerHighLight": "#ddebed",
    "md3OutlineVariantLight": "#b1cbd0",
    "md3OutlineLight": "#637b80",
    "md3SurfaceContainerHighestLight": "#d7e5e8",
    "md3OnSecondaryContainerLight": "#075232",
    "md3OnErrorContainerLight": "#93000a",
    "md3PrimaryDark": "#76daa2",
    "md3SecondaryDark": "#92d5ab",
    "md3TertiaryDark": "#82d3e1",
    "md3ErrorDark": "#ffb4ab",
    "md3OnSurfaceDark": "#d7e5e8",
    "md3OnSurfaceVariantDark": "#b1cbd0",
    "md3SurfaceDark": "#000000",
    "md3SurfaceContainerDark": "#152224",
    "md3SurfaceContainerHighDark": "#202c2e",
    "md3OutlineVariantDark": "#334b4f",
    "md3OutlineDark": "#7c959a",
    "md3SurfaceContainerHighestDark": "#2b3739",
    "md3OnSecondaryContainerDark": "#adf2c6",
    "md3OnErrorContainerDark": "#ffdad6"
