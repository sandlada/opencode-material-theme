      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "syntaxVariable": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "syntaxString": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "syntaxNumber": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "syntaxType": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "syntaxOperator": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "syntaxPunctuation": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    }
