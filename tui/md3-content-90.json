{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#725900",
    "md3SecondaryLight": "#6d5d32",
    "md3TertiaryLight": "#4d6615",
    "md3ErrorLight": "#ba1a1a",
    "md3OnSurfaceLight": "#1f1b14",
    "md3OnSurfaceVariantLight": "#4d4636",
    "md3SurfaceLight": "#fff8f1",
    "md3SurfaceContainerLight": "#f5ede0",
    "md3SurfaceContainerHighLight": "#efe7db",
    "md3OutlineVariantLight": "#d0c5b0",
    "md3OutlineLight": "#7f7664",
    "md3SurfaceContainerHighestLight": "#eae1d5",
    "md3OnSecondaryContainerLight": "#716136",
    "md3OnErrorContainerLight": "#93000a",
    "md3PrimaryDark": "#e9c255",
    "md3SecondaryDark": "#dac591",
    "md3TertiaryDark": "#b3d274",
    "md3ErrorDark": "#ffb4ab",
    "md3OnSurfaceDark": "#eae1d5",
