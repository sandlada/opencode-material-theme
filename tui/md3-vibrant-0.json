{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#ad1c5f",
    "md3SecondaryLight": "#963777",
    "md3TertiaryLight": "#534db6",
    "md3ErrorLight": "#b41340",
    "md3OnSurfaceLight": "#482239",
    "md3OnSurfaceVariantLight": "#7b4e68",
    "md3SurfaceLight": "#fff4f7",
    "md3SurfaceContainerLight": "#ffe0ee",
    "md3SurfaceContainerHighLight": "#ffd8eb",
    "md3OutlineVariantLight": "#d49dbb",
    "md3OutlineLight": "#996884",
    "md3SurfaceContainerHighestLight": "#ffd0e8",
