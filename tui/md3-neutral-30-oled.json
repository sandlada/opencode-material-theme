  "theme": {
    "primary": {
      "dark": "md3PrimaryDark",
      "light": "md3PrimaryLight"
    },
    "secondary": {
      "dark": "md3SecondaryDark",
      "light": "md3SecondaryLight"
    },
    "accent": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "error": {
      "dark": "md3ErrorDark",
      "light": "md3ErrorLight"
    },
    "warning": {
      "dark": "md3OnErrorContainerDark",
      "light": "md3OnErrorContainerLight"
    },
    "success": {
      "dark": "md3TertiaryDark",
      "light": "md3TertiaryLight"
    },
    "info": {
      "dark": "md3OnSecondaryContainerDark",
      "light": "md3OnSecondaryContainerLight"
    },
    "text": {
      "dark": "md3OnSurfaceDark",
      "light": "md3OnSurfaceLight"
    },
    "textMuted": {
      "dark": "md3OnSurfaceVariantDark",
      "light": "md3OnSurfaceVariantLight"
    },
    "background": {
      "dark": "md3SurfaceDark",
      "light": "md3SurfaceLight"
    },
    "backgroundPanel": {
      "dark": "md3SurfaceContainerDark",
      "light": "md3SurfaceContainerLight"
    },
    "backgroundElement": {
      "dark": "md3SurfaceContainerHighDark",
      "light": "md3SurfaceContainerHighLight"
