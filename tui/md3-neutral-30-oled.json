      "dark": "md3SurfaceContainerHighestDark",
      "light": "md3SurfaceContainerHighestLight"
    },
    "diffContextBg": {
      "dark": "md3SurfaceContainerDark",
      "light": "md3SurfaceContainerLight"
    },
    "diffLineNumber": {
      "dark": "md3OutlineDark",
      "light": "md3OutlineLight"
