{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#6c5b57",
    "md3SecondaryLight": "#665d5b",
    "md3TertiaryLight": "#795561",
    "md3ErrorLight": "#9e3f4e",
    "md3OnSurfaceLight": "#373130",
    "md3OnSurfaceVariantLight": "#655d5c",
    "md3SurfaceLight": "#fff8f6",
    "md3SurfaceContainerLight": "#f5ecea",
    "md3SurfaceContainerHighLight": "#f0e6e4",
    "md3OutlineVariantLight": "#b9b0ae",
    "md3OutlineLight": "#817977",
    "md3SurfaceContainerHighestLight": "#ebe0de",
    "md3OnSecondaryContainerLight": "#58504e",
    "md3OnErrorContainerLight": "#782232",
    "md3PrimaryDark": "#d8c2bd",
    "md3SecondaryDark": "#a79b99",
    "md3TertiaryDark": "#ffd5e1",
    "md3ErrorDark": "#ec7c8a",
    "md3OnSurfaceDark": "#eee3e1",
    "md3OnSurfaceVariantDark": "#b2a9a7",
    "md3SurfaceDark": "#000000",
    "md3SurfaceContainerDark": "#1c1918",
    "md3SurfaceContainerHighDark": "#231f1e",
    "md3OutlineVariantDark": "#4d4645",
    "md3OutlineDark": "#7c7472",
    "md3SurfaceContainerHighestDark": "#2a2523",
    "md3OnSecondaryContainerDark": "#c9bdba",
    "md3OnErrorContainerDark": "#ff97a3"
