{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#9921a5",
    "md3SecondaryLight": "#923881",
    "md3TertiaryLight": "#9f3a22",
    "md3ErrorLight": "#b41340",
    "md3OnSurfaceLight": "#46223d",
    "md3OnSurfaceVariantLight": "#784e6c",
    "md3SurfaceLight": "#fff4f8",
    "md3SurfaceContainerLight": "#ffdff2",
    "md3SurfaceContainerHighLight": "#ffd7f0",
    "md3OutlineVariantLight": "#d09ec0",
    "md3OutlineLight": "#966988",
    "md3SurfaceContainerHighestLight": "#ffcfee",
    "md3OnSecondaryContainerLight": "#7a226b",
    "md3OnErrorContainerLight": "#510017",
    "md3PrimaryDark": "#f87eff",
    "md3SecondaryDark": "#fb92e1",
    "md3TertiaryDark": "#ff987f",
    "md3ErrorDark": "#ff6e84",
    "md3OnSurfaceDark": "#ffdcf1",
    "md3OnSurfaceVariantDark": "#ce9cbe",
    "md3SurfaceDark": "#20031b",
    "md3SurfaceContainerDark": "#30092a",
    "md3SurfaceContainerHighDark": "#390e31",
