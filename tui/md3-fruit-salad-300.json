{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "md3PrimaryLight": "#00629d",
    "md3SecondaryLight": "#31628d",
    "md3TertiaryLight": "#66558e",
    "md3ErrorLight": "#ba1a1a",
    "md3OnSurfaceLight": "#1d1a24",
    "md3OnSurfaceVariantLight": "#4a4458",
    "md3SurfaceLight": "#fef7ff",
    "md3SurfaceContainerLight": "#f3ebfa",
    "md3SurfaceContainerHighLight": "#ede5f4",
    "md3OutlineVariantLight": "#ccc2db",
    "md3OutlineLight": "#7b738a",
    "md3SurfaceContainerHighestLight": "#e7e0ee",
    "md3OnSecondaryContainerLight": "#124a73",
    "md3OnErrorContainerLight": "#93000a",
    "md3PrimaryDark": "#99cbff",
    "md3SecondaryDark": "#9dcbfb",
    "md3TertiaryDark": "#d0bcfe",
    "md3ErrorDark": "#ffb4ab",
    "md3OnSurfaceDark": "#e7e0ee",
    "md3OnSurfaceVariantDark": "#ccc2db",
    "md3SurfaceDark": "#15121c",
    "md3SurfaceContainerDark": "#211e28",
    "md3SurfaceContainerHighDark": "#2c2833",
    "md3OutlineVariantDark": "#4a4458",
    "md3OutlineDark": "#958da4",
    "md3SurfaceContainerHighestDark": "#37333e",
    "md3OnSecondaryContainerDark": "#cfe5ff",
    "md3OnErrorContainerDark": "#ffdad6"
